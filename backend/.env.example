# ─────────────────────────────────────────────────────────────────────────────
# GoRideXpress — Backend environment
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
API_PREFIX=api
API_VERSION=v1

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/goridexpress

# ── Redis (sessions, rate limiting, cache, OTP/reset tokens) ────────────────
REDIS_URL=redis://127.0.0.1:6379
# When Redis is unavailable the API degrades gracefully to in-memory + Mongo.
REDIS_ENABLED=true

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_long_xxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_long_xxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookies ─────────────────────────────────────────────────────────────────
# Leave COOKIE_DOMAIN empty for localhost.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma separated list of allowed origins. Never use `*` with credentials.
CORS_ORIGIN=http://localhost:3000

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=uploads

# ── Rate limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_LOGIN_LIMIT=10
THROTTLE_REGISTER_LIMIT=5
THROTTLE_PAYMENT_LIMIT=20

# ── Demo / simulation ───────────────────────────────────────────────────────
# Simulated gateway delay in ms (1–2s per SRS).
PAYMENT_SIMULATION_DELAY_MS=1500
DEMO_SEED_ON_BOOT=false
